+     * Phone downloads: the formats of the first download client whose separate video and audio files come with links,
+     * ready to fetch (signatures and n params applied). Never changes the client the player uses. Null when none has.
+     */
+    public VideoInfo getDownloadVideoInfo(String videoId) {
+        if (videoId == null) {
+            return null;
+        }
+
+        for (AppClient client : DOWNLOAD_CLIENT_LIST) {
+            try {
+                VideoInfo result = getVideoInfo(client, videoId, null);
+
+                if (result == null || result.isUnplayable() || result.getAdaptiveFormats() == null || result.getAdaptiveFormats().isEmpty()) {
+                    continue;
+                }
+
+                transformFormats(result);
+
+                if (hasAdaptiveUrls(result)) {
+                    return result;
+                }
+            } catch (Exception e) {
+                Log.e(TAG, "Download formats from %s failed: %s", client, e.getMessage());
+            }
+        }
+
+        return null;
+    }
+
+    /** The user agent the download client's file links expect */
+    public static String getDownloadUserAgent(VideoInfo videoInfo) {
+        AppClient client = videoInfo != null ? videoInfo.getClient() : null;
+        return client != null ? client.getUserAgent() : AppClient.VISIONOS.getUserAgent();
+    }
+
+    private static boolean hasAdaptiveUrls(VideoInfo videoInfo) {
+        for (com.liskovsoft.youtubeapi.videoinfo.models.formats.AdaptiveVideoFormat format : videoInfo.getAdaptiveFormats()) {
+            if (format != null && format.getUrl() != null) {
+                return true;
+            }
+        }
+
+        return false;
+    }
