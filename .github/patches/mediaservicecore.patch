+package com.liskovsoft.youtubeapi.service;
+
+import androidx.annotation.Nullable;
+
+import com.liskovsoft.mediaserviceinterfaces.data.MediaItemFormatInfo;
+import com.liskovsoft.sharedutils.rx.RxHelper;
+import com.liskovsoft.youtubeapi.service.data.YouTubeMediaItemFormatInfo;
+import com.liskovsoft.youtubeapi.videoinfo.V2.VideoInfoService;
+import com.liskovsoft.youtubeapi.videoinfo.models.VideoInfo;
+
+import io.reactivex.Observable;
+
+/**
+ * Phone downloads: the formats of a client whose separate video and audio files come with direct links (the player's
+ * TV client streams them with SABR only), plus the user agent those links expect. The player is not affected.
+ */
+public final class YouTubeDownloadService {
+    public static final class DownloadInfo {
+        public final MediaItemFormatInfo formatInfo;
+        public final String userAgent;
+
+        DownloadInfo(MediaItemFormatInfo formatInfo, String userAgent) {
+            this.formatInfo = formatInfo;
+            this.userAgent = userAgent;
+        }
+    }
+
+    private YouTubeDownloadService() {
+    }
+
+    /** Null when no download client gives file links for this video */
+    @Nullable
+    public static DownloadInfo getDownloadInfo(String videoId) {
+        VideoInfo videoInfo = VideoInfoService.instance().getDownloadVideoInfo(videoId);
+
+        if (videoInfo == null) {
+            return null;
+        }
+
+        return new DownloadInfo(YouTubeMediaItemFormatInfo.from(videoInfo), VideoInfoService.getDownloadUserAgent(videoInfo));
+    }
+
+    /** Errors (no file links) instead of emitting null */
+    public static Observable<DownloadInfo> getDownloadInfoObserve(String videoId) {
+        return RxHelper.fromCallable(() -> getDownloadInfo(videoId));
+    }
+}
