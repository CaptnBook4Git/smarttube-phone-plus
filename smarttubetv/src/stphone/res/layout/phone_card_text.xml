<?xml version="1.0" encoding="utf-8"?>
<!-- Avatar + title + channel/views/time + 3-dot button + quick actions (shared by phone_item_video and phone_item_shelf_card) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/phone_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="2dp"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/phone_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/phone_text"
                android:textSize="15sp"
                android:lineSpacingExtra="2dp"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:id="@+id/phone_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/phone_text_2"
                android:textSize="12sp"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/phone_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_phone_more"
            android:tint="@color/phone_text_2"
            android:contentDescription="@string/phone_more_options"/>
    </LinearLayout>

    <include
        layout="@layout/phone_quick_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"/>
</LinearLayout>
