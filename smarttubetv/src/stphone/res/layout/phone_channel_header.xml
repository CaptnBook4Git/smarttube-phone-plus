<?xml version="1.0" encoding="utf-8"?>
<!-- Channel page header, laid out like the YouTube app: banner, picture, name, handle and counts, description, Subscribe, tabs -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.liskovsoft.smartyoutubetv2.tv.phone.widget.RatioFrameLayout
        android:id="@+id/phone_channel_banner_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/phone_round_thumb"
        android:visibility="gone">

        <ImageView
            android:id="@+id/phone_channel_banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
    </com.liskovsoft.smartyoutubetv2.tv.phone.widget.RatioFrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/phone_channel_avatar"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/phone_circle_bg"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/phone_channel_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="@color/phone_text"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/phone_channel_handle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/phone_text"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/phone_channel_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/phone_text_2"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/phone_channel_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/phone_ripple"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/phone_text_2"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/phone_channel_subscribe"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/phone_button_bg"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/phone_subscribe"
        android:textColor="@color/phone_bg"
        android:textSize="15sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/phone_channel_tabs"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/phone_divider" />

    <View
        android:layout_width="match_parent"
        android:layout_height="8dp" />
</LinearLayout>
