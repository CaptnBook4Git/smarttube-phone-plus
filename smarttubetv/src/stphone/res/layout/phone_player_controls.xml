<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/phone_controls"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#8C000000"
    android:clickable="true"
    android:focusable="false"
    android:visibility="gone">

    <ImageView
        android:id="@+id/phone_ctl_collapse"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="4dp"
        android:padding="10dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/phone_back"
        android:src="@drawable/ic_phone_collapse"
        android:tint="#FFFFFF" />

    <!-- Title, shown in full screen only -->
    <TextView
        android:id="@+id/phone_ctl_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="60dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="112dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:shadowColor="#99000000"
        android:shadowRadius="4"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/phone_ctl_cc"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="11dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/phone_captions"
            android:src="@drawable/ic_phone_cc"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/phone_ctl_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="11dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/phone_quality"
            android:src="@drawable/ic_phone_settings"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/phone_ctl_prev"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/phone_previous"
            android:src="@drawable/ic_phone_prev"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/phone_ctl_play"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:padding="14dp"
            android:background="@drawable/phone_play_bg"
            android:contentDescription="@string/phone_play_pause"
            android:src="@drawable/ic_phone_pause"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/phone_ctl_next"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/phone_next"
            android:src="@drawable/ic_phone_next"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/phone_ctl_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/phone_ctl_fullscreen"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/phone_fullscreen"
                android:src="@drawable/ic_phone_fullscreen"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/phone_ctl_seek"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginBottom="-8dp"
            android:max="1000"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progressBackgroundTint="#66FFFFFF"
            android:progressTint="@color/phone_accent"
            android:splitTrack="false"
            android:thumbTint="@color/phone_accent" />
    </LinearLayout>
</FrameLayout>
