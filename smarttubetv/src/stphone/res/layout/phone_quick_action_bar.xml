<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/phone_quick_actions"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never"
    android:clipToPadding="false"
    android:alpha="0.72">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:id="@+id/phone_quick_watch_later"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:gravity="center"
            android:background="@drawable/phone_pill_bg"
            android:contentDescription="@string/phone_you_watch_later">

            <ImageView
                android:id="@+id/phone_quick_watch_later_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_phone_watch_later"
                android:tint="@color/phone_text_2"
                android:importantForAccessibility="no"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/phone_quick_like"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:gravity="center"
            android:background="@drawable/phone_pill_bg"
            android:contentDescription="@string/phone_like"
            android:visibility="gone">

            <ImageView
                android:id="@+id/phone_quick_like_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_phone_like"
                android:tint="@color/phone_text_2"
                android:importantForAccessibility="no"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/phone_quick_dislike"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:gravity="center"
            android:background="@drawable/phone_pill_bg"
            android:contentDescription="@string/phone_dislike"
            android:visibility="gone">

            <ImageView
                android:id="@+id/phone_quick_dislike_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_phone_dislike"
                android:tint="@color/phone_text_2"
                android:importantForAccessibility="no"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/phone_quick_remove_history"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:gravity="center"
            android:background="@drawable/phone_pill_bg"
            android:contentDescription="@string/remove_from_history"
            android:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_phone_close"
                android:tint="@color/phone_text_2"
                android:importantForAccessibility="no"/>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/phone_quick_dismiss_group"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/phone_pill_bg">

            <LinearLayout
                android:id="@+id/phone_quick_not_interested"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/phone_quick_not_interested">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_phone_not_interested"
                    android:tint="@color/phone_text_2"
                    android:importantForAccessibility="no"/>
            </LinearLayout>

            <View
                android:id="@+id/phone_quick_dismiss_divider"
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:background="@color/phone_divider"/>

            <LinearLayout
                android:id="@+id/phone_quick_dont_recommend_channel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/phone_quick_dont_recommend_channel">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_phone_block_channel"
                    android:tint="@color/phone_text_2"
                    android:importantForAccessibility="no"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</HorizontalScrollView>
