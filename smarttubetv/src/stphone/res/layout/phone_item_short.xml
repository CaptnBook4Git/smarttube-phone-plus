<?xml version="1.0" encoding="utf-8"?>
<com.liskovsoft.smartyoutubetv2.tv.phone.widget.RatioFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/phone_thumb_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/phone_round_thumb"
    android:stateListAnimator="@animator/phone_press"
    android:foreground="@drawable/phone_ripple">

    <ImageView
        android:id="@+id/phone_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <!-- Top-right quick actions overlay on Short tiles -->
    <LinearLayout
        android:id="@+id/phone_quick_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/phone_quick_like"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/phone_play_bg"
            android:contentDescription="@string/phone_like">

            <ImageView
                android:id="@+id/phone_quick_like_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_phone_like"
                android:tint="@android:color/white"
                android:importantForAccessibility="no"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/phone_quick_dislike"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/phone_play_bg"
            android:contentDescription="@string/phone_dislike">

            <ImageView
                android:id="@+id/phone_quick_dislike_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_phone_dislike"
                android:tint="@android:color/white"
                android:importantForAccessibility="no"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/phone_quick_not_interested"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/phone_play_bg"
            android:contentDescription="@string/phone_quick_not_interested">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_phone_not_interested"
                android:tint="@android:color/white"
                android:importantForAccessibility="no"/>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/phone_scrim_bottom"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="36dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/phone_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:shadowColor="#99000000"
            android:shadowRadius="4"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/phone_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#D9FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</com.liskovsoft.smartyoutubetv2.tv.phone.widget.RatioFrameLayout>
