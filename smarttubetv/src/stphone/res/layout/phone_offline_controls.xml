<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#44000000">

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:gravity="center_vertical">
        <ImageButton android:id="@id/exo_rew"
            android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_phone_seek_back_10" android:tint="@android:color/white"
            android:contentDescription="@string/phone_seek_back_10"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
        <ImageButton android:id="@id/exo_play"
            android:layout_width="64dp" android:layout_height="56dp" android:padding="12dp"
            android:src="@drawable/ic_phone_play" android:scaleType="fitCenter" android:tint="@android:color/white"
            android:contentDescription="@string/exo_controls_play_description"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
        <ImageButton android:id="@id/exo_pause"
            android:layout_width="64dp" android:layout_height="56dp" android:padding="12dp"
            android:src="@drawable/ic_phone_pause" android:scaleType="fitCenter" android:tint="@android:color/white"
            android:contentDescription="@string/exo_controls_pause_description"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
        <ImageButton android:id="@id/exo_ffwd"
            android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_phone_seek_ahead_10" android:tint="@android:color/white"
            android:contentDescription="@string/phone_seek_ahead_10"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <ImageButton android:id="@+id/phone_offline_speed"
        android:layout_width="48dp" android:layout_height="48dp"
        android:layout_gravity="top|end" android:padding="12dp"
        android:src="@drawable/ic_phone_speed" android:tint="@android:color/white"
        android:contentDescription="@string/phone_playback_speed"
        android:background="?android:attr/selectableItemBackgroundBorderless" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_gravity="bottom" android:gravity="center_vertical" android:paddingStart="12dp"
        android:background="@drawable/phone_scrim_bottom">
        <TextView android:id="@id/exo_position"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@android:color/white" android:textSize="12sp"
            android:fontFeatureSettings="tnum" />
        <com.google.android.exoplayer2.ui.DefaultTimeBar android:id="@id/exo_progress"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
            app:played_color="@color/phone_accent" app:scrubber_color="@color/phone_accent" />
        <TextView android:id="@id/exo_duration"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="8dp" android:textColor="@android:color/white"
            android:textSize="12sp" android:fontFeatureSettings="tnum" />
        <ImageButton android:id="@+id/phone_offline_fullscreen"
            android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
            android:src="@drawable/ic_phone_fullscreen" android:tint="@android:color/white"
            android:contentDescription="@string/phone_fullscreen"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
</FrameLayout>
