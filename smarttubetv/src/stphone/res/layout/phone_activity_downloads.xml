<?xml version="1.0" encoding="utf-8"?>
<!-- You > Downloads: the videos and audio saved to Download/StreamTube -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/phone_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phone_bg"
    android:fitsSystemWindows="false"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/phone_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/phone_bg"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/phone_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/phone_back"
            android:src="@drawable/ic_phone_back"
            android:tint="@color/phone_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/phone_downloads"
            android:textColor="@color/phone_text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/phone_downloads_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/phone_text_2"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/phone_downloads_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/phone_downloads_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:text="@string/phone_downloads_empty"
            android:textColor="@color/phone_text_2"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
