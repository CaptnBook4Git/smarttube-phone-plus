<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp">
    <LinearLayout android:id="@+id/phone_moment_play"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:minHeight="52dp" android:paddingStart="8dp" android:paddingTop="6dp" android:paddingBottom="6dp"
        android:gravity="center_vertical" android:focusable="true" android:background="@drawable/phone_ripple">
        <TextView android:id="@+id/phone_moment_time"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minWidth="64dp" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="5dp" android:paddingBottom="5dp" android:fontFamily="@font/roboto_medium"
            android:textColor="@color/phone_link" android:textSize="14sp" android:background="@drawable/phone_pill_bg" />
        <TextView android:id="@+id/phone_moment_note"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:layout_marginEnd="8dp"
            android:textSize="15sp" android:textColor="@color/phone_text" />
    </LinearLayout>
    <ImageButton android:id="@+id/phone_moment_options"
        android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp"
        android:src="@drawable/ic_phone_more" android:tint="@color/phone_text_2"
        android:background="?android:attr/selectableItemBackgroundBorderless" />
</LinearLayout>
