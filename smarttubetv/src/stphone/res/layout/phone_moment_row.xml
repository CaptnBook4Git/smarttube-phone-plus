<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
    android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="4dp"
    android:paddingStart="12dp" android:paddingEnd="2dp" android:gravity="center_vertical"
    android:focusable="true" android:background="@drawable/phone_card_bg"
    android:clipToOutline="true" android:foreground="@drawable/phone_ripple">
    <TextView android:id="@+id/phone_moment_time"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center"
        android:minWidth="64dp" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="5dp" android:paddingBottom="5dp" android:fontFamily="@font/roboto_medium"
        android:importantForAccessibility="no" android:textColor="@color/phone_moment_ink"
        android:textSize="14sp" android:background="@drawable/phone_moment_chip" />
    <TextView android:id="@+id/phone_moment_note"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="12dp" android:paddingTop="8dp" android:paddingBottom="8dp"
        android:importantForAccessibility="no" android:textSize="15sp" android:textColor="@color/phone_text" />
    <ImageButton android:id="@+id/phone_moment_options"
        android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp"
        android:src="@drawable/ic_phone_more" android:tint="@color/phone_text_2"
        android:background="?android:attr/selectableItemBackgroundBorderless" />
</LinearLayout>
