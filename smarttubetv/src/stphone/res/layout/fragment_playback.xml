<?xml version="1.0" encoding="utf-8"?>
<!-- Phone build: overrides the TV player layout. Video on top (16:9 in portrait, full screen in landscape), details below.
     The phone controls are added from code after switching to the phone density (this layout inflates with TV density). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/phone_player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <com.liskovsoft.smartyoutubetv2.tv.phone.widget.RatioFrameLayout
        android:id="@+id/phone_video_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000">

        <fragment
            android:id="@+id/playback_controls_fragment"
            android:name="com.liskovsoft.smartyoutubetv2.tv.phone.PhonePlaybackFragment"
            android:tag="@string/playback_tag"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.liskovsoft.smartyoutubetv2.tv.phone.widget.RatioFrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/phone_player_details"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/phone_bg"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:scrollbars="none" />
</LinearLayout>
