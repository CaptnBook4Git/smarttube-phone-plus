<?xml version="1.0" encoding="utf-8"?>
<!-- Phone build: overrides the TV player layout. Video on top (16:9 in portrait, full screen in landscape), details below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/phone_player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <com.liskovsoft.smartyoutubetv2.tv.phone.widget.RatioFrameLayout
        android:id="@+id/phone_video_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000">

        <fragment
            android:id="@+id/playback_controls_fragment"
            android:name="com.liskovsoft.smartyoutubetv2.tv.phone.PhonePlaybackFragment"
            android:tag="@string/playback_tag"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/phone_mini_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="1000"
            android:progressBackgroundTint="#55FFFFFF"
            android:progressTint="@color/phone_accent" />

        <include layout="@layout/phone_player_controls" />

        <include layout="@layout/phone_shorts_overlay" />
    </com.liskovsoft.smartyoutubetv2.tv.phone.widget.RatioFrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/phone_player_details"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/phone_bg"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:scrollbars="none" />
</LinearLayout>
