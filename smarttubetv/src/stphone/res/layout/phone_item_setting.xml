<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/phone_ripple"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/phone_thumb"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:tint="@color/phone_text" />

    <TextView
        android:id="@+id/phone_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/phone_text"
        android:textSize="15sp" />

    <!-- The current value ("Dark"), for rows that have one -->
    <TextView
        android:id="@+id/phone_setting_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        android:maxLines="1"
        android:textColor="@color/phone_text_2"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- On/off rows: the whole row is the button, the switch only shows the state -->
    <Switch
        android:id="@+id/phone_setting_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:clickable="false"
        android:focusable="false"
        android:thumbTint="@color/phone_update_switch_thumb"
        android:trackTint="@color/phone_update_switch_track"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/phone_setting_chevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_phone_chevron"
        android:tint="@color/phone_text_2" />
</LinearLayout>
