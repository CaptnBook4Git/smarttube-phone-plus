<?xml version="1.0" encoding="utf-8"?>
<!-- Shorts: full screen vertical video. Swipe up/down for next/previous, tap to pause. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/phone_shorts"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <View
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_gravity="bottom"
        android:background="@drawable/phone_scrim_bottom" />

    <ImageView
        android:id="@+id/phone_shorts_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="6dp"
        android:padding="11dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/phone_back"
        android:src="@drawable/ic_phone_back"
        android:tint="#FFFFFF" />

    <ImageView
        android:id="@+id/phone_shorts_paused"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_gravity="center"
        android:alpha="0.9"
        android:background="@drawable/phone_play_bg"
        android:importantForAccessibility="no"
        android:padding="20dp"
        android:src="@drawable/ic_phone_play"
        android:tint="#FFFFFF"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/phone_shorts_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="28dp"
        android:gravity="center_horizontal"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="84dp"
        android:layout_marginBottom="30dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/phone_shorts_channel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/phone_shorts_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/phone_shorts_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:maxWidth="180dp"
                android:shadowColor="#99000000"
                android:shadowRadius="4"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/phone_shorts_subscribe"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/phone_button_bg"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/phone_subscribe"
                android:textColor="@color/phone_bg"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/phone_shorts_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:shadowColor="#99000000"
            android:shadowRadius="4"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
