<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/phone_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <LinearLayout
        android:id="@+id/phone_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/phone_sheet_bg"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <View
            android:id="@+id/phone_sheet_handle"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/phone_handle" />

        <LinearLayout
            android:id="@+id/phone_sheet_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/phone_sheet_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/phone_back"
                android:src="@drawable/ic_phone_back"
                android:tint="@color/phone_text"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/phone_sheet_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:textColor="@color/phone_text"
                    android:textSize="18sp" />

                <!-- Comments: the total next to the title -->
                <TextView
                    android:id="@+id/phone_sheet_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:maxLines="1"
                    android:textColor="@color/phone_text_2"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Comments: Top / Newest -->
            <LinearLayout
                android:id="@+id/phone_sheet_sort"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/phone_sheet_sort_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/phone_text_2"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/phone_sheet_sort_chevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:rotation="90"
                    android:src="@drawable/ic_phone_chevron"
                    android:tint="@color/phone_text_2" />
            </LinearLayout>

            <ImageView
                android:id="@+id/phone_sheet_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/phone_close"
                android:src="@drawable/ic_phone_close"
                android:tint="@color/phone_text" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/phone_divider" />

        <!-- Comments: Chapter filter bar -->
        <LinearLayout
            android:id="@+id/phone_sheet_chapter_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/phone_sheet_chapter_filter"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/phone_pill_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:id="@+id/phone_sheet_chapter_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_phone_chapters"
                    android:tint="@color/phone_text" />

                <TextView
                    android:id="@+id/phone_sheet_chapter_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/phone_text"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/phone_sheet_chapter_chevron"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:rotation="90"
                    android:src="@drawable/ic_phone_chevron"
                    android:tint="@color/phone_text_2" />
            </LinearLayout>

            <TextView
                android:id="@+id/phone_sheet_chapter_stats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/phone_text_2"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:id="@+id/phone_sheet_chapter_divider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/phone_divider"
            android:visibility="gone" />

        <com.liskovsoft.smartyoutubetv2.tv.phone.widget.MaxHeightFrameLayout
            android:id="@+id/phone_sheet_list_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/phone_sheet_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:paddingTop="4dp"
                android:scrollbars="none" />
        </com.liskovsoft.smartyoutubetv2.tv.phone.widget.MaxHeightFrameLayout>

        <!-- Comments: write a comment or a reply (the sheet rises with the keyboard) -->
        <LinearLayout
            android:id="@+id/phone_sheet_composer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/phone_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="6dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/phone_sheet_composer_avatar"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:importantForAccessibility="no" />

                <EditText
                    android:id="@+id/phone_sheet_composer_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/phone_field_bg"
                    android:gravity="center_vertical"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="10000"
                    android:maxLines="5"
                    android:minHeight="42dp"
                    android:paddingStart="16dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="9dp"
                    android:textColor="@color/phone_text"
                    android:textColorHint="@color/phone_text_2"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/phone_sheet_composer_send"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/phone_comment_send"
                    android:padding="11dp"
                    android:src="@drawable/ic_phone_send"
                    android:tint="@color/phone_text" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
