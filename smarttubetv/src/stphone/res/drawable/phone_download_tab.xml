<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:gravity="bottom|center_horizontal" android:width="32dp" android:height="3dp">
                <shape><corners android:radius="2dp"/><solid android:color="@color/phone_accent"/></shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent"/>
</selector>
